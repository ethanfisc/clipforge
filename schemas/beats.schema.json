{
  "$defs": {
    "Beat": {
      "additionalProperties": false,
      "properties": {
        "beat_id": {
          "minimum": 0,
          "title": "Beat Id",
          "type": "integer"
        },
        "scene_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Scene Ids",
          "type": "array"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "intent": {
          "default": "unknown",
          "enum": [
            "hook",
            "step",
            "payoff",
            "broll",
            "unknown"
          ],
          "title": "Intent",
          "type": "string"
        },
        "priority": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        }
      },
      "required": [
        "beat_id",
        "start_s",
        "end_s"
      ],
      "title": "Beat",
      "type": "object"
    },
    "Files": {
      "additionalProperties": false,
      "properties": {
        "raw_path": {
          "title": "Raw Path",
          "type": "string"
        },
        "normalized_path": {
          "title": "Normalized Path",
          "type": "string"
        }
      },
      "required": [
        "raw_path",
        "normalized_path"
      ],
      "title": "Files",
      "type": "object"
    },
    "Keyframe": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "ts_s": {
          "minimum": 0,
          "title": "Ts S",
          "type": "number"
        }
      },
      "required": [
        "path",
        "ts_s"
      ],
      "title": "Keyframe",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "minimum": 0,
          "title": "Scene Id",
          "type": "integer"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/Keyframe"
          },
          "title": "Keyframes",
          "type": "array"
        },
        "vision": {
          "$ref": "#/$defs/Vision"
        }
      },
      "required": [
        "scene_id",
        "start_s",
        "end_s"
      ],
      "title": "Scene",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "video_id": {
          "title": "Video Id",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "url",
        "video_id"
      ],
      "title": "Source",
      "type": "object"
    },
    "VideoMeta": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "fps": {
          "const": 30,
          "default": 30,
          "title": "Fps",
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "sar": {
          "const": "1:1",
          "default": "1:1",
          "title": "Sar",
          "type": "string"
        }
      },
      "required": [
        "duration_s",
        "width",
        "height"
      ],
      "title": "VideoMeta",
      "type": "object"
    },
    "Vision": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "text_on_screen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text On Screen"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "title": "Vision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "files": {
      "$ref": "#/$defs/Files"
    },
    "video": {
      "$ref": "#/$defs/VideoMeta"
    },
    "params": {
      "additionalProperties": true,
      "title": "Params",
      "type": "object"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "title": "Scenes",
      "type": "array"
    },
    "beats": {
      "items": {
        "$ref": "#/$defs/Beat"
      },
      "title": "Beats",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "source",
    "files",
    "video"
  ],
  "title": "BeatsRun",
  "type": "object"
}